# Banco de dados compartilhado (obrigatório) — usado para salas de voz, chat e presença.
# Na Vercel: adicione esta variável no painel (Settings > Environment Variables) e faça Deploy.
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Reactus API raiz (somente scheme + host; sem caminho)
REACTUS_BASE_URL=https://dev-reactus-api.happyseeds.ai

# HappySeeds (validação do selo e PROJECT_ID)
HAPPYSEEDS_PROJECT_ID=

# Umami Analytics (opcional — remova se não for usar)
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-umami-domain/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-website-id"